{
  "confirmation_salt": "tb-policy-v1:",
  "secret_patterns": ["sk-[A-Za-z0-9-]+", "AKIA[0-9A-Z]{16}", "SECRET_[A-Z0-9_]+"],
  "tools": [
    {
      "name": "drive.read",
      "side_effect": "read",
      "required_scopes": ["drive:read"],
      "resource_action": "read",
      "parameters": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "pattern": "^/docs/[A-Za-z0-9._/-]+$"}
        }
      },
      "argument_policies": {
        "path": {"source": "trusted_user", "path_prefixes": ["/docs/"], "reject_traversal": true}
      }
    },
    {
      "name": "drive.share",
      "side_effect": "external_write",
      "required_scopes": ["drive:share"],
      "resource_action": "share",
      "requires_confirmation": true,
      "parameters": {
        "type": "object",
        "required": ["path", "recipient"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "pattern": "^/docs/[A-Za-z0-9._/-]+$"},
          "recipient": {"type": "string", "format": "email"}
        }
      },
      "argument_policies": {
        "path": {"source": "trusted_user", "resource_ref": "path", "path_prefixes": ["/docs/"], "reject_traversal": true},
        "recipient": {"source": "trusted_user", "domain_allowlist": ["company.example"]}
      }
    },
    {
      "name": "mail.send",
      "side_effect": "external_write",
      "required_scopes": ["mail:send"],
      "requires_confirmation": true,
      "parameters": {
        "type": "object",
        "required": ["to", "subject", "body"],
        "additionalProperties": false,
        "properties": {
          "to": {"type": "string", "format": "email"},
          "subject": {"type": "string", "maxLength": 120},
          "body": {"type": "string", "maxLength": 1000}
        }
      },
      "argument_policies": {
        "to": {"source": "trusted_user", "domain_allowlist": ["company.example"]},
        "subject": {"source": "trusted_user"},
        "body": {"source": "trusted_user", "secret_safe": true}
      }
    },
    {
      "name": "web.fetch",
      "side_effect": "read",
      "required_scopes": ["web:read"],
      "parameters": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": {
          "url": {"type": "string", "format": "uri"}
        }
      },
      "argument_policies": {
        "url": {"source": "trusted_user", "domain_allowlist": ["company.example", "docs.python.org"], "https_only": true}
      }
    }
  ]
}
